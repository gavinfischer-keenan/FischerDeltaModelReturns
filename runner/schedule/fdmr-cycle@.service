# One model-runner cycle: `hourly` or `nightly` (runner/schedule/cycle.sh).
# Low priority on top of the container's own limits: Electric Eel comes first.
[Unit]
Description=FDMR model runner cycle (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=fdmr
Group=fdmr
ExecStart=/home/fdmr/fdmr/runner/schedule/cycle.sh %i
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=50min
