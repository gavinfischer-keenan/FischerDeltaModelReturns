     !> deallocate sediment variables
+    subroutine allocate_settled_bed(ncell, nsediment, initial)
+        implicit none
+        integer, intent(in) :: ncell
+        integer, intent(in) :: nsediment
+        real(gtm_real), intent(in) :: initial
+        allocate(settled(ncell,nsediment))
+        allocate(settled_net1(ncell,nsediment))
+        allocate(settled_erosion1(ncell,nsediment))
+        allocate(settled_erosion(ncell,nsediment))
+        settled = initial
+        settled_net1 = zero
+        settled_erosion1 = zero
+        settled_erosion = zero
+    end subroutine
+
+    !> fdmr: each output step, every cell's settled sediment (kg/m2) and erosion
+    !> flux (kg/m2/s) of the first class, as two arrays of 4-byte reals, appended
+    !> to a stream file beside the HDF5 output (<name>_bed.bin).
+    subroutine write_settled_bed(hdf_name)
+        implicit none
+        character(len=*), intent(in) :: hdf_name
+        integer :: k
+        if (.not. allocated(settled)) return
+        if (.not. settled_open) then
+            k = index(hdf_name, '.', .true.)
+            if (k .le. 1) k = len_trim(hdf_name) + 1
+            open(newunit=settled_unit, file=hdf_name(1:k-1)//'_bed.bin', access='stream', &
+                 form='unformatted', status='replace')
+            settled_open = .true.
+        end if
+        write(settled_unit) real(settled(:,1), 4), real(settled_erosion(:,1), 4)   ! 4-byte reals: half the size
+        flush(settled_unit)
+    end subroutine
+
     subroutine dealloacte_sediment_variables()
         implicit none
         deallocate(diameter)
